<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>RpcKit.SignalR.Client</PackageId>
    <Description>Implementação SignalR cliente de RpcKit — HubConnection wrapper, SignalRRpcInvoker, RpcConnectionHost, agent dispatchers (HandleInvoke / ServeDuplex). Para MAUI, Worker Services e WASM.</Description>
    <PackageTags>rpc;signalr;client;maui;worker;wasm</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Rpc.Core\Rpc.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
